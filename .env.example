# Copy to .env, then add your own API key. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: public repositories work without a token, subject to GitHub rate limits.
GITHUB_TOKEN=
# V1 local development defaults (Compose sets its internal addresses itself).
QDRANT_URL=http://localhost:6333
EMBEDDING_CACHE=.model-cache
